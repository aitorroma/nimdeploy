# Dashboard and API token (at least 16 characters): openssl rand -hex 32
NIMDEPLOY_HUB_TOKEN=

# Optional: a header your authenticating proxy sets, e.g. with Cloudflare Access:
# NIMDEPLOY_HUB_TRUSTED_HEADER=Cf-Access-Authenticated-User-Email
# Only if the proxy is the only way to reach the hub (it must set or strip it).

# NIMDEPLOY_HUB_RETAIN_DAYS=90
# NIMDEPLOY_HUB_PUBLISH=127.0.0.1:9100
# NIMDEPLOY_VERSION=v0.8.0
