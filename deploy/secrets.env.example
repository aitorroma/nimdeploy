# /etc/nimdeploy/secrets.env  (chmod 600, owned by root)
# systemd reads it on start: restart nimdeploy after changing it.
FRONTEND_WEBHOOK_SECRET=change-me
AGENCY_WEBHOOK_SECRET=change-me
BACKEND_WEBHOOK_SECRET=change-me

# Filled in by install.sh
NIMDEPLOY_API_TOKEN=

